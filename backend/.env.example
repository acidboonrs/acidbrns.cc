# Umgebungsvariablen für XMPP Registration Backend
# WICHTIG: Diese Datei kopieren nach .env und mit echten Werten füllen!
# .env niemals committen.

# Datenbank-Konfiguration
DB_HOST=localhost
DB_NAME=xmpp_registration
DB_USER=xmpp_web
DB_PASSWORD=HIER-SICHERES-PASSWORT-EINTRAGEN
DB_PORT=5432
# Optional: vollständige Connection-URL (überschreibt die Einzelwerte oben)
# DATABASE_URL=postgresql://xmpp_web:passwort@localhost:5432/xmpp_registration

# XMPP Domain (deine Domain!)
XMPP_DOMAIN=deine-domain.de

# Prosody
PROSODY_PATH=/usr/bin/prosodyctl
# Validierter Wrapper, über den der Web-User Accounts anlegt/ändert/löscht
# (siehe scripts/xmpp-prosody-admin + scripts/sudoers-xmpp-registration)
PROSODY_ADMIN=/usr/local/sbin/xmpp-prosody-admin

# Flask Debug Modus (nur für Entwicklung!)
FLASK_DEBUG=False

# Signing-Secrets (je ein langer Zufallswert, z.B. `openssl rand -hex 32`)
# MATH_CAPTCHA_SECRET: signiert die Mathe-Captcha-Tokens (Bot-Schutz)
# TDWALL_SECRET:       signiert die Bot-Schutz-Gate-Tokens/Cookies
MATH_CAPTCHA_SECRET=HIER-LANGES-ZUFALLS-SECRET-EINTRAGEN
TDWALL_SECRET=HIER-LANGES-ZUFALLS-SECRET-EINTRAGEN

# Email-Versand (Passwort-Reset), z.B. Proton Mail Bridge / SMTP
# MAIL_SERVER=smtp.example.org
# MAIL_PORT=587
# MAIL_USERNAME=noreply@deine-domain.de
# MAIL_PASSWORD=app-passwort
# MAIL_USE_TLS=True
# MAIL_FROM=noreply@deine-domain.de
# APP_BASE_URL=https://deine-domain.de
